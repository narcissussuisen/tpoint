# ===== tpoint 版本控制忽略规则（重建于 2026-08-12）=====
# 目标：纳入核心代码/配置/文档，排除大体积运行时产物。

# 虚拟环境（1.9G，绝不入库）
venv/
__pycache__/
*.pyc
*.pyo

# 大数据目录（47M 分钟K/状态，绝不入库；仅保留关键配置）
# 注意：必须用 data/* 而非 data/ —— 后者会排除整个目录导致下方例外失效
data/*
# 例外：保留运行时关键配置（真相源）
!data/monitor_config.json
!data/watchlist.json

# 回测/产物/日志（68M / 21M，绝不入库）
# 注意：必须用 output/* 而非 output/ —— 后者排除整个目录导致下方例外失效（git 规则：
# 父目录被排除时子路径无法 re-include；与上方 data/* 注释同源教训，2026-09-28 实踩）。
output/*
logs/

# 例外：ML 注册表/模型/训练证据（小体积关键产物，2026-09-28 起入库）
# 教训：2026-08-05 v10 灾难恢复丢失全部 ML 产物（ml_features.py 从未入库 +
# output/ 整体被忽略 ⇒ 模型/注册表/数据集纯磁盘存活，重建即蒸发）。
# 数据集本体在 F: 盘（可用已入库的 ml_build_dataset.py 2.3 分钟重建），不入库。
!output/ml_versions.json
!output/ml_train_results_v2.json
!output/ml_models/
!output/ml_models/*.json

# loop_engine 运行日志（累计增长、纯运行时产物；曾误入库 → 2026-09-10 停止跟踪）
scripts/loop_engine/loop_engine.log

# 备份产物（非版本控制对象；例：scripts/run_daily_review.bat.bak_t1_20260903。
# 被备份的版本本身已在 git 历史中，故 .bak 无需入库）
scripts/*.bak*

# 杂项
nul
err.txt
*.tmp
.pytest_cache/
.mypy_cache/

# 敏感/本地（绝不入库）
.local/
.workbuddy/
.monitor.log
ml_shadow_offline_*.json
ml_shadow_offline_*.csv
push_feishu_html
