# ===== tpoint 版本控制忽略规则（重建于 2026-08-12）=====
# 目标：纳入核心代码/配置/文档，排除大体积运行时产物。

# 虚拟环境（1.9G，绝不入库）
venv/
__pycache__/
*.pyc
*.pyo

# 大数据目录（47M 分钟K/状态，绝不入库；仅保留关键配置）
# 注意：必须用 data/* 而非 data/ —— 后者会排除整个目录导致下方例外失效
data/*
# 例外：保留运行时关键配置（真相源）
!data/monitor_config.json
!data/watchlist.json

# 回测/产物/日志（68M / 21M，绝不入库）
output/
logs/

# 杂项
nul
err.txt
*.tmp
.pytest_cache/
.mypy_cache/

# 敏感/本地（绝不入库）
.local/
.workbuddy/
.monitor.log
ml_shadow_offline_*.json
ml_shadow_offline_*.csv
push_feishu_html
